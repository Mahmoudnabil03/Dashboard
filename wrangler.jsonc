{
  "name": "dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aqarx-db",
      "database_id": "8d796cf2-a5a4-486c-b830-62e15077ace8"
    }
  ],
  "observability": {
    "enabled": true
  }
}
