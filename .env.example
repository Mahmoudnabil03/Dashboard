# Copy to .dev.vars for local wrangler dev (NEVER commit real secrets).
# Production: npx wrangler secret put <NAME>

# Auth (required)
JWT_SECRET=

# Frontend origin used for OAuth callbacks and CORS (required in production)
FRONTEND_URL=http://localhost:8787

# AI: Workers AI binding is primary (no secret needed).
# Optional overrides:
AI_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Social OAuth (create apps in each developer console; see README)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Webhook verify tokens (any random string; must match platform config)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
LINKEDIN_WEBHOOK_VERIFY_TOKEN=
TIKTOK_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_VERIFY_TOKEN=

# Email provider (optional; mock logs to console when absent)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=noreply@socialhub.example.com

# Observability
LOG_LEVEL=info
